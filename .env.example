NEXT_PUBLIC_SITE_URL=https://www.bidje.com

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# TELEGRAM BOT API
TELEGRAM_BOT_TOKEN=<TOKEN_API>
TELEGRAM_GROUP_CHAT_ID=<CHAT_ID>
TELEGRAM_ALLOWED_SENDER_IDS=<ALLOWED_SENDER>
TELEGRAM_WEBHOOK_SECRET=<SECRET_KEY>
CRON_SECRET=

# Payment Fiuu
FIUU_MERCHANT_ID=your_sandbox_merchant_id
FIUU_VERIFY_KEY=your_sandbox_verify_key
FIUU_SECRET_KEY=your_sandbox_secret_key
FIUU_ENV=sandbox   # or "production"

# Twilio Configuration
TWILIO_ACCOUNT_SID=xxxx
TWILIO_AUTH_TOKEN=your_new_regenerated_auth_token

# Approved Twilio WhatsApp Sender
TWILIO_WHATSAPP_NUMBER=whatsapp:+60126359606
TWILIO_REMINDER_TEMPLATE_SID=HXc1d4d5bde6e3c66b5e7fd99da8830829

# Meta WhatsApp Cloud API - BIDJE auction alerts
# Keep the real permanent access token ONLY in Vercel environment variables.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_AUCTION_TEMPLATE_NAME=bidje_auction_alert_v1
META_WHATSAPP_AUCTION_TEMPLATE_LANG=en_US
META_GRAPH_API_VERSION=v24.0
# Comma-separated E.164 recipients, e.g. +60123456789,+60111222333
AUCTION_ALERT_RECIPIENTS=
AUCTION_ALERT_SOURCE_MAX_PAGES=1

# SendGrid Configuration
SENDGRID_API_KEY=SG.xxxx
SENDGRID_FROM_EMAIL=admin@bidje.com

# AI Monitoring
ANTHROPIC_API_KEY=sk-ant-xxxxx
# AI provider: "openai" (default, ChatGPT), "gemini" or "anthropic"
AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional, defaults to gpt-5-mini
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash
GEMINI_MODEL=
